# VOQR is not packaged with vsce. scripts/package/pack.py builds one package per platform
# from the explicit list in scripts/package/voqr-package.json and does not read this file.
# Packaging with vsce under these rules leaves out the runtime modules VOQR needs.
.vscode/**
.claude/**
.pytest_cache/**
node_modules/**
debug_data/**
images/**
videos/**
assets/**
src/**
server/tests/**
server/__pycache__/**
*.ts
*.map
tsconfig.json
esbuild.js
eslint.config.mjs
.gitignore
HANDOFF.md
ROADMAP.md
VISION.md
CONTRIBUTING.md
scripts/**
voqr-debug.log
**/*.mkv
**/*.vsix
